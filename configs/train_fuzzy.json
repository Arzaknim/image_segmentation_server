{
  "model": {
    "name": "efficientnet_b0",
    "pretrained": true
  },
  "dataset": {
    "image_dir": "../Dataset_Flattened/images",
    "mask_dir": "../Dataset_Flattened/masks",
    "tile_size": 512,
    "tile_stride": 256
  },
  "training": {
    "num_epochs": 40,
    "batch_size": 6
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.00001
  },
  "scheduler": {
    "name": "CosineAnnealingLR",
    "eta_min": 0.0001
  },
  "criterion": {
    "name": "fuzzy",
    "fuzziness": 0.1,
    "fuzzifier_m": 1.5,
    "temperature": 1.0,
    "ignore_index": 5
  }
}

