{
  "model": {
    "name": "efficientnet_b0",
    "pretrained": true
  },
  "dataset": {
    "dataset_base_dir": "../Dataset_5Fold_512",
    "tile_size": 512,
    "tile_stride": 256,
    "num_workers": 4
  },
  "training": {
    "num_epochs": 30,
    "batch_size": 6,
    "device": null
  },
  "optimizer": {
    "name": "AdamW",
    "lr": 0.001,
    "weight_decay": 0.0001
  },
  "scheduler": {
    "name": "CosineAnnealingLR",
    "eta_min": 0.0001
  },
  "criterion": {
    "name": "ce_dice",
    "ignore_index": 5
  }
}

